// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model userinfo {
  id    Int    @id @default(autoincrement())
  name  String
  lastName  String
  sex   SEX
  birthDay  DateTime
  address String
  homePhone String
  mobile String
  workPhone String
  email String @unique
  nationalNumber String @unique
  type  TYPE
  password String
  userDocs userDoc[]
  subProjects subProject[]
  isargaryPercent  ISARGARIPERCENT?
  azadeEsaratMonths Int?
  azadeMonths Int?
  shahedFamilyNumber Int?
  shahedRelation SHAHEDRELATION?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model userDoc {
  id  Int @id @default(autoincrement())
  user  userinfo @relation(fields: [userId], references: [id])
  userId  Int
  documet String
  detail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model project {
  id  Int @id @default(autoincrement())
  name  String
  address String
  sharedArea  Int
  floorCount Int
  unitCount Int
  landArea  Int
  buildingArea  Int
  blockNumber Int
  options String?
  startDate DateTime
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subProjects subProject[]
}

model subProject {
  id  Int @id @default(autoincrement())
  area  Int
  floor Int
  point  Int
  block Int
  roomCount Int
  options String?
  user userinfo? @relation(fields: [userId], references: [id])
  userId  Int?
  project project @relation(fields: [projectId], references: [id])
  posts post[]
  projectId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model post {
  id  Int @id @default(autoincrement())
  subProject subProject @relation(fields: [subProjectId], references: [id])
  subProjectId Int
  detail  String?
  available Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SEX {
  male
  female
}

enum TYPE {
  system
  admin
  tehranUni
  otherUni
  free
  employee
}

enum SHAHEDRELATION {
  azade_wife
  azade_child
  jan_wife
  jan_child
}

enum ISARGARIPERCENT {
  val10_15
  val15_20
  val20_plus
}
