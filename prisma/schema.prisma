// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model userinfo {
  id    Int    @id @default(autoincrement())
  name  String
  lastName  String
  sex   SEX
  birthDay  DateTime?
  address String?
  homePhone String?
  mobile String?
  workPhone String?
  email String?
  nationalNumber String @unique
  type  TYPE?
  password String
  userDocs userDoc[]
  finalTransaction finalTransaction[]
  transactionHistory  transactionHistory[]
  subProjects subProject[]
  subProjectTickets subProjectTicket[]
  subProjectChat subProjectChat[]
  invoices invoice[]
  otherChats otherChat[]
  otherTicketsReciever otherTicket[] @relation("recieverRelation")
  otherTicketsUser otherTicket[] @relation("userRelation")
  isargaryPercent  ISARGARIPERCENT?
  transactions transaction[]
  preSellings preSelling[]
  azadeEsaratMonths Int?
  azadeMonths Int?
  shahedFamilyNumber Int?
  shahedRelation SHAHEDRELATION?
  accepted  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model userDoc {
  id  Int @id @default(autoincrement())
  user  userinfo @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  document String
  detail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model projectDoc {
  id  Int @id @default(autoincrement())
  project  project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  document String
  detail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model subProjectDoc {
  id  Int @id @default(autoincrement())
  subProject  subProject @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  subProjectId  Int
  document String
  detail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model project {
  id  Int @id @default(autoincrement())
  name  String
  address String?
  landArea  Int?
  startDate DateTime
  endDate DateTime?
  longitude Float?
  latitude Float?
  pricePerMeter  Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  preSellings preSelling[]
  blocks block[]
  projectDocs projectDoc[]
}

model block {
  id  Int @id @default(autoincrement())
  name  String
  floorCount Int
  shareArea Int
  buildingArea Int
  description String?
  projectId Int
  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subProjects subProject[]
}

model subProject {
  id  Int @id @default(autoincrement())
  area  Int
  floor Int
  point  Int  @default(0)
  roomCount Int
  options String?
  pricePerMeter  Float @default(0)
  direction String
  unitNumber  Int @default(0)
  user userinfo? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId  Int?
  block block @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId Int
  posts post[]
  transactionHistory transactionHistory[]
  invoice invoice[]
  finalTransaction finalTransaction[]
  subProjectTickets subProjectTicket[]
  subProjectDocs  subProjectDoc[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model preSelling {
  id Int @id @default(autoincrement())
  user  userinfo @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  project  project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  area  Int
  totalPrice Float
  transaction transaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model transactionHistory {
  id  Int @id @default(autoincrement())
  subProject  subProject @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  subProjectId  Int
  user  userinfo @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model transaction {
  id  Int @id @default(autoincrement())
  user  userinfo @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  preselling  preSelling @relation(fields: [presellingId], references: [id], onDelete: Cascade)
  presellingId Int
  amount  Float
  bank  String
  targetBank  String
  number  String @unique
  document  String?
  detail  String?
  date  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model finalTransaction {
  id  Int @id @default(autoincrement())
  user  userinfo @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  subProject  subProject @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  subProjectId Int
  amount  Float
  bank  String
  targetBank  String
  number  String @unique
  document  String?
  detail  String?
  date  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model invoice {
  id  Int @id @default(autoincrement())
  user  userinfo @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  subProject subProject @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  subProjectId Int
  amount  Float?
  number  String?
  document  String
  detail  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model post {
  id  Int @id @default(autoincrement())
  subProject subProject @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  subProjectId Int
  detail  String?
  available Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model subProjectTicket {
  id  Int @id @default(autoincrement())
  subProject subProject @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  subProjectId Int
  user userinfo @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  senderRead  Boolean @default(true)
  adminRead Boolean @default(false)
  closed  Boolean @default(false)
  type subProjectTicketType
  chats subProjectChat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model subProjectChat {
  id  Int @id @default(autoincrement())
  ticket subProjectTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId Int
  sender userinfo @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId Int
  message String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model otherChat {
  id  Int @id @default(autoincrement())
  ticket otherTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId Int
  sender userinfo @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId Int
  message String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model otherTicket {
  id  Int @id @default(autoincrement())
  user userinfo @relation("userRelation", fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  reciever userinfo? @relation("recieverRelation", fields: [recieverId], references: [id], onDelete: Cascade)
  recieverId Int?
  type String
  senderRead  Boolean @default(true)
  recieverRead Boolean @default(false)
  closed  Boolean @default(false)
  chats otherChat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum subProjectTicketType {
  buy
  sell
}

enum SEX {
  male
  female
}

enum TYPE {
  system
  admin
  tehranUni
  otherUni
  free
  employee
}

enum SHAHEDRELATION {
  azade_wife
  azade_child
  jan_wife
  jan_child
}

enum ISARGARIPERCENT {
  val10_15
  val15_20
  val20_plus
}
